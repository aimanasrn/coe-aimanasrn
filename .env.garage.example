# Garage creates this key and bucket on first start.
# Access key: "GK" followed by the output of: openssl rand -hex 16
# Secret key: the output of: openssl rand -hex 32
GARAGE_DEFAULT_ACCESS_KEY=GK_replace_with_32_hex_characters
GARAGE_DEFAULT_SECRET_KEY=replace_with_64_hex_characters
GARAGE_DEFAULT_BUCKET=studymart

# Laravel reads the same credentials. Leave these lines as they are.
AWS_ACCESS_KEY_ID=${GARAGE_DEFAULT_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${GARAGE_DEFAULT_SECRET_KEY}
AWS_BUCKET=${GARAGE_DEFAULT_BUCKET}
